:root {
  --bg: #fbfbf9;
  --warm: #f6f5f0;
  --ink: #26272b;
  --muted: #6b6d74;
  --line: #e6e5df;
  --dark: #0f1115;
  --max: 1136px;
  --g-green: #6bb86f;
  --g-blue: #3b7bdc;
  --g-purple: #9a4fd8;
  --g-yellow: #e3b93d;
}

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 84px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-weight: 400;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

h1, h2, h3 {
  font-weight: 400;
  margin: 0;
  letter-spacing: -0.035em;
  line-height: 1.08;
}

p {
  margin: 0;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

ul, ol, dl, dd {
  margin: 0;
  padding: 0;
  list-style: none;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: 100%;
  max-width: calc(var(--max) + 48px);
  margin: 0 auto;
  padding: 0 24px;
}

.section {
  padding: 96px 0;
}

.section-warm {
  background: var(--warm);
}

.mono, .eyebrow, .tag, .chip {
  font-family: 'JetBrains Mono', monospace;
}

.mono {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}
.eyebrow {
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 20px;
}

.eyebrow-bar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.eyebrow-bar::before {
  content: "";
  width: 36px;
  height: 8px;
  border-radius: 4px;
  flex: none;
  background: linear-gradient(90deg, var(--g-green), var(--g-blue));
}

h2 {
  font-size: 44px;
  letter-spacing: -0.04em;
  max-width: 14em;
}

.h-big {
  font-size: 64px;
  max-width: 12em;
}

.lead {
  font-size: 20px;
  line-height: 1.7;
  color: var(--muted);
  max-width: 36em;
  margin-top: 24px;
}

.lead-dark {
  color: var(--ink);
  font-size: 18px;
  margin-top: 28px;
  max-width: none;
}

.lead-wide {
  max-width: none;
}

.grad-text {
  background: linear-gradient(
    90deg,
    #3aa8a8 0%,
    #3b7bdc 50%,
    #a04fe0 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.grad-text-green {
  background-image: linear-gradient(
    90deg,
    #5cb36a 0%,
    #3aa5a5 40%,
    #3b7bdc 100%
  );
}