:root {
  --bg: #fbfbf9;
  --warm: #f6f5f0;
  --ink: #26272b;
  --muted: #6b6d74;
  --line: #e6e5df;
  --dark: #0f1115;
  --max: 1136px;
  --g-green: #6bb86f;
  --g-blue: #3b7bdc;
  --g-purple: #9a4fd8;
  --g-yellow: #e3b93d;
}

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 84px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-weight: 400;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

h1, h2, h3 {
  font-weight: 400;
  margin: 0;
  letter-spacing: -0.035em;
  line-height: 1.08;
}

p {
  margin: 0;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

ul, ol, dl, dd {
  margin: 0;
  padding: 0;
  list-style: none;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: 100%;
  max-width: calc(var(--max) + 48px);
  margin: 0 auto;
  padding: 0 24px;
}

.section {
  padding: 96px 0;
}

.section-warm {
  background: var(--warm);
}

.mono, .eyebrow, .tag, .chip {
  font-family: 'JetBrains Mono', monospace;
}

.mono {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}
.eyebrow {
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 20px;
}

.eyebrow-bar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.eyebrow-bar::before {
  content: "";
  width: 36px;
  height: 8px;
  border-radius: 4px;
  flex: none;
  background: linear-gradient(90deg, var(--g-green), var(--g-blue));
}

h2 {
  font-size: 44px;
  letter-spacing: -0.04em;
  max-width: 14em;
}

.h-big {
  font-size: 64px;
  max-width: 12em;
}

.lead {
  font-size: 20px;
  line-height: 1.7;
  color: var(--muted);
  max-width: 36em;
  margin-top: 24px;
}

.lead-dark {
  color: var(--ink);
  font-size: 18px;
  margin-top: 28px;
  max-width: none;
}

.lead-wide {
  max-width: none;
}

.grad-text {
  background: linear-gradient(
    90deg,
    #3aa8a8 0%,
    #3b7bdc 50%,
    #a04fe0 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.grad-text-green {
  background-image: linear-gradient(
    90deg,
    #5cb36a 0%,
    #3aa5a5 40%,
    #3b7bdc 100%
  );
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 26px;
  border-radius: 999px;
  font-weight: 500;
  font-size: 16px;
  border: 1px solid transparent;
  transition: background .2s, color .2s, transform .2s,
              box-shadow .2s;
}

.btn-dark {
  background: #1b1c20;
  color: #fff;
}

.btn-dark:hover {
  background: #3a3c44;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(0,0,0,.18);
}

.btn-small {
  padding: 11px 20px;
  font-size: 15px;
}

.link-arrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 500;
  padding: 8px 2px;
  border-bottom: 1px solid transparent;
}

.link-arrow:hover {
  border-bottom-color: currentColor;
}

a:focus-visible {
  outline: 3px solid #5b8fe8;
  outline-offset: 3px;
  border-radius: 8px;
}

.btn:focus-visible {
  border-radius: 999px;
}
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(251,251,249,.88);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66px;
  gap: 24px;
}

.logo {
  display: flex;
  flex: none;
}

.nav {
  flex: 1;
  display: flex;
  justify-content: center;
}

.nav-list {
  display: flex;
  gap: 28px;
  font-size: 16px;
  color: var(--muted);
}

.nav-list a {
  padding: 6px 2px;
  border-bottom: 1px solid transparent;
  transition: color .2s;
}

.nav-list a:hover {
  color: var(--ink);
  border-bottom-color: currentColor;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: none;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: #fff;
  font-size: 13px;
  color: var(--muted);
  transition: background .2s, border-color .2s;
}

.pill:hover {
  background: #f1f0ea;
  border-color: #cfcdc4;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #e0457b;
  flex: none;
}
.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 80% 15%, #f3dce8, transparent 60%),
    radial-gradient(ellipse at 60% 0%, #fae6d1, transparent 55%),
    #fbfbfa;
  padding: 100px 0 0;
  min-height: 720px;
}

.hero-graph {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  -webkit-mask-image: radial-gradient(ellipse, #000 60%, transparent 100%);
  mask-image: radial-gradient(ellipse, #000 60%, transparent 100%);
}

.hero-graph canvas {
  display: block;
  background: transparent;
  pointer-events: none;
}

.hero > .container {
  position: relative;
  z-index: 1;
}

.hero-symbol {
  margin-bottom: 38px;
}

.hero h1 {
  font-size: 96px;
  letter-spacing: -0.05em;
  line-height: 1.05;
  max-width: 9.5em;
}

.hero-lead {
  font-size: 24px;
  line-height: 1.55;
  color: var(--muted);
  max-width: 34em;
  margin-top: 42px;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 44px;
}
.shot {
  position: relative;
  overflow: hidden;
  background: #fff;
  border: 1px solid #d9dde8;
  border-radius: 16px;
  box-shadow: 0 30px 80px rgba(120,110,170,.18);
}

.shot img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top left;
}

.shot-hero {
  margin-top: 136px;
  height: 492px;
  border-bottom: 0;
  border-radius: 16px 16px 0 0;
}

.shot-atlas {
  margin-top: 72px;
  height: 428px;
  box-shadow: none;
  border-color: var(--line);
}

.cards {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 40px;
}

.card {
  flex: 1 1 300px;
  padding: 40px 36px 36px;
  border-radius: 16px;
  border: 1px solid;
  min-height: 278px;
}

.card p {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.6;
}

.card-title {
  font-size: 28px;
  letter-spacing: -0.03em;
  margin-bottom: 22px;
}

.card-title span {
  color: var(--muted);
  font-weight: 300;
}

.card-green {
  border-color: #cfe5d3;
  background: linear-gradient(
    180deg, #e8f4ea 0%, rgba(232,244,234,0) 60%
  );
}

.card-blue {
  border-color: #ccd8f1;
  background: linear-gradient(
    180deg, #e9effb 0%, rgba(233,239,251,0) 60%
  );
}

.card-purple {
  border-color: #e2c9f0;
  background: linear-gradient(
    180deg, #f3e6f9 0%, rgba(243,230,249,0) 60%
  );
}

.core {
  position: relative;
  display: flex;
  align-items: center;
  gap: 100px;
  margin-top: 20px;
  padding: 34px 33px;
  background: #f5f5f3;
  border: 1px solid var(--line);
  border-radius: 12px;
}

.core::before {
  content: "";
  position: absolute;
  left: 24px;
  right: 24px;
  top: -9px;
  height: 9px;
  border: 1px dashed var(--line);
  border-bottom: 0;
  border-radius: 10px 10px 0 0;
}

.core .card-title {
  font-size: 22px;
  margin: 0;
  flex: 0 0 180px;
}

.core p {
  font-size: 15px;
  color: var(--muted);
  max-width: 700px;
}
.message {
  padding: 82px 0 90px;
  text-align: center;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background:
    radial-gradient(
      ellipse 40% 60% at 95% 0%, #bcd0ec, transparent 70%
    ),
    radial-gradient(
      ellipse 45% 60% at 5% 105%, #d3dfb8, transparent 70%
    ),
    #f1f0ea;
}

.message-main {
  font-size: 32px;
  letter-spacing: -0.03em;
  line-height: 1.25;
  max-width: 20em;
  margin: 0 auto;
}

.message-main strong {
  font-weight: 500;
}

.message-sub {
  font-size: 32px;
  letter-spacing: -0.03em;
  color: var(--muted);
  margin-top: 28px;
}

#value h2 {
  max-width: 17.5em;
}

.panel {
  margin-top: 48px;
  max-width: 978px;
  background: #fff;
  border-radius: 16px;
  padding: 30px 40px 34px;
  border: 1px solid #cdd7ea;
  box-shadow: 0 24px 50px rgba(110,110,150,.12);
}

.panel-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px 24px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--line);
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 32px 60px;
  margin-top: 18px;
}

.metric {
  flex: 1 1 280px;
  padding-left: 4px;
}

.metric-label {
  position: relative;
  padding-top: 12px;
}

.metric-label::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 18px;
  height: 4px;
  border-radius: 2px;
  background: linear-gradient(90deg, var(--g-green), var(--g-blue));
}

.metric-num {
  font-size: 84px;
  letter-spacing: -0.05em;
  line-height: 1.1;
  margin: 14px 0 6px;
}

.cur {
  color: #80828b;
  font-weight: 300;
}

.unit {
  font-size: 40px;
  color: #80828b;
  margin-left: 6px;
  letter-spacing: -0.03em;
}

.metric-note {
  font-size: 13px;
  color: var(--muted);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 8px;
}

.chip {
  display: inline-block;
  padding: 3px 9px;
  font-size: 11px;
  border-radius: 999px;
  color: var(--ink);
  border: 1px solid;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

.chip-green {background: #e2f2ee;border-color: #c5e3db;}

.chip-blue {background: #e3ecf8; border-color: #c9d9ef;}
.field {padding: 120px 0;color: #fff;background:
    radial-gradient( ellipse 45% 70% at 90% 20%, rgba(55,110,100,.55), transparent 70%),
    radial-gradient(ellipse 30% 40% at 75% 45%, rgba(95,100,45,.45), transparent 70%),var(--dark);}

.field .eyebrow { color: #c2c5cc;}

.field-inner {display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 56px 70px;}

.field-main {flex: 1 1 520px;max-width: 640px;}

.field-num {font-size: 136px;letter-spacing: -0.05em;line-height: 1;font-weight: 300; margin-top: 8px;}

.field-cap {color: #c2c5cc; margin-top: 16px;letter-spacing: .12em;}

.field-text {font-size: 18px;line-height: 1.62; color: #b9bcc4; margin-top: 44px;}

.field-note { font-size: 13px; line-height: 1.6;color: #8f939b;margin-top: 44px;padding-top: 28px; border-top: 1px solid #2a2d34; max-width: 552px;}

.datasheet { flex: 0 1 444px; position: relative;padding: 30px 29px 20px;border-radius: 16px;background: rgba(30,32,36,.78);
  border: 1px solid #2d3036; box-shadow: 0 20px 50px rgba(0,0,0,.35);}

.datasheet::before {content: "";position: absolute; left: 0;right: 0;top: -1px;height: 2px; border-radius: 16px 16px 0 0;
  background: linear-gradient( 90deg, #d7b640, #5cb36a, #3b7bdc, #a04fe0);
}

.datasheet-title {color: #9a9ea6; margin-bottom: 20px;padding-bottom: 14px;border-bottom: 1px solid #2d3036;font-family: 'JetBrains Mono', monospace;}

.datasheet div {display: flex;justify-content: space-between;align-items: center;gap: 16px;padding: 20px 0;border-bottom: 1px solid #2d3036;}

.datasheet div:last-child {border-bottom: 0;}

.datasheet dt {font-size: 14px;color: #c1c4cb;}

.datasheet dd {font-size: 22px;letter-spacing: -0.02em;text-align: right;}
.section-warm h2 {max-width: 20em;}

.wf-list { margin-top: 64px;border-top: 1px solid var(--line);}

.wf {display: flex;align-items: flex-start;gap: 0;border-bottom: 1px solid var(--line);padding: 36px 0;position: relative;transition: background .2s;}

.wf:hover {background: rgba(255,255,255,.55);}

.wf-tag {flex: 0 0 240px;padding-top: 6px;}

.tag {display: inline-block;font-size: 11px;
  letter-spacing: .1em;text-transform: uppercase;color: #b26a37;padding: 5px 11px;border-radius: 999px;background: #f9e8d3;border: 1px solid #f0d6b6;}

.tag-sub {color: #7a7c84;background: #f1f0ea;border-color: #dad9d1;text-transform: none;letter-spacing: 0;}

.wf-body { flex: 1 1 auto;max-width: 660px;}

.wf-body h3 { font-size: 24px;letter-spacing: -0.025em; margin-bottom: 14px;}
.wf-body p { font-size: 16px;line-height: 1.6;color: var(--muted);}
.wf-arrow { margin-left: auto;align-self: center;font-size: 22px;color: var(--muted);opacity: 0;transition: opacity .2s, transform .2s;}
.wf:hover .wf-arrow {opacity: 1;transform: translateX(4px);}

.wf-sub {background: linear-gradient(90deg, #efeeea 0%, rgba(239,238,234,0) 45%);}
.wf-sub:hover { background: linear-gradient(90deg, #ebeae5 0%, rgba(239,238,234,.3) 45%);}
.wf-sub .wf-tag {padding-left: 48px; flex-basis: 288px;}
.wf-sub .wf-body h3 {font-size: 20px;}

.steps { display: flex;flex-wrap: wrap; gap: 40px;margin-top: 72px;}
.steps li {flex: 1 1 200px;border-top: 2px solid var(--ink); padding-top: 22px;}

.steps h3 {font-size: 26px;letter-spacing: -0.02em;margin-bottom: 12px;}
.steps p {font-size: 15.5px; line-height: 1.55;color: var(--muted);}

.atlas-intro { font-size: 20px;color: var(--ink);max-width: 28em;margin-top: 64px;}

.atlas-demo {display: flex;flex-wrap: wrap;gap: 40px 56px;margin-top: 56px;align-items: flex-start;}

.ask {flex: 1 1 400px;max-width: 622px;display: flex;align-items: center;gap: 12px;padding: 16px 16px 16px 20px;background: #fff;
  border: 1px solid #cfcfd4;border-radius: 12px;box-shadow: 0 2px 6px rgba(0,0,0,.08), inset 0 0 0 1px rgba(255,255,255,.8);}

.ask-icon {flex: none;color: var(--muted);opacity: .75;}
.ask-text {flex: 1;font-size: 17px;}
.caret {display: inline-block; width: 2px;height: 1.1em;background: var(--ink);vertical-align: text-bottom;margin-left: 2px;}

.ask .btn {background: #26272b;border-radius: 6px;padding: 10px 16px;font-size: 14px;}
.nodes {flex: 1 1 420px;max-width: 460px;}
.nodes-title {margin-bottom: 14px;}
.nodes-row {display: flex;flex-wrap: wrap;gap: 12px;}
.node {flex: 1 1 190px;padding: 18px 18px 16px;border: 1px solid #b9d9bf;border-radius: 10px;background: #fcfdfb;}
.node p {font-size: 15px;line-height: 1.45;margin-bottom: 12px;}
.node-tag {display: flex;align-items: flex-start;gap: 8px;color: #46484f;font-size: 11px;margin-bottom: 12px;}
.dot-green {flex: none;width: 8px;height: 8px;margin-top: 3px;border-radius: 50%;background: #3f8f52;}
.node-ok {display: flex;align-items: center;gap: 8px;margin: 0 !important;font-size: 13px !important;color: #3f8f52;}

.node-ok svg {flex: none;}
#governance {padding-top: 0;}

.gov-cards {display: flex;flex-wrap: wrap;gap: 20px;margin-top: 44px;}

.gov { flex: 1 1 220px;position: relative; padding: 30px 36px 36px;min-height: 192px;background: var(--bg);
  border: 1px solid var(--line);border-radius: 12px;overflow: hidden;}

.gov::before { content: "";position: absolute;left: 0;right: 0;top: 0;height: 3px;background: var(--c);}
.gov h3 {display: flex;align-items: center;gap: 12px;font-size: 28px;letter-spacing: -0.03em;margin-bottom: 22px;}
.dash { width: 14px; height: 3px;border-radius: 2px; background: var(--c);flex: none;}
.gov p { font-size: 15px;line-height: 1.6;color: var(--muted);max-width: 11.5em;}
.gov-blue { --c: #4c9be0;}
.gov-green {--c: #5cb36a;}
.gov-purple {--c: #9a2fd0;}
.gov-yellow { --c: #e8c030;}

.run {display: flex;flex-wrap: wrap;margin-top: 56px;}
.run li { flex: 1 1 200px;padding-right: 20px;}
.run-n {position: relative;display: flex;align-items: center;gap: 8px;padding-left: 13px;margin-bottom: 22px;letter-spacing: .15em;}
.run-n::after { content: "";flex: 1;height: 2px;background: var(--line-g);}

.run-1 {--line-g: linear-gradient(90deg, #d9b93e, #5cb36a);}
.run-2 {--line-g: linear-gradient(90deg, #4fb58a, #3b8be0);}
.run-3 {--line-g: linear-gradient(90deg, #3b7bdc, #9a2fd0);}
.run-4 { --line-g: linear-gradient(90deg, #a04fe0, rgba(160,79,224,0));}

.run h3 {font-size: 16px;font-weight: 500;letter-spacing: -0.01em;margin-bottom: 10px;}
.run li p:last-child {font-size: 13px; color: var(--muted);}
.guarantees {display: flex;flex-wrap: wrap;justify-content: center;gap: 8px 0; margin-top: 52px;font-size: 11px;}
.guarantees li + li::before {content: "·";margin: 0 14px;color: #a7a9af;}

.start {padding: 150px 0 80px;border-top: 1px solid var(--line);background:
    radial-gradient(ellipse 40% 45% at 0% 0%, #d4dcec, transparent 70%),
    radial-gradient( ellipse 45% 40% at 100% 100%, #ecd1d8, transparent 70%), #f4f1eb;}
.start .lead {font-size: 22px;margin-top: 36px;}
.start .actions {margin-top: 36px;}

.trust { display: flex; flex-wrap: wrap; margin-top: 96px;border-top: 1px solid rgba(0,0,0,.09);}
.trust li {flex: 1 1 260px;padding: 32px 36px 32px 0;position: relative;}
.trust li + li {padding-left: 28px;}
.trust li + li::before { content: "";position: absolute;left: 0;top: 32px;bottom: 0;width: 1px;background: rgba(0,0,0,.1);}

.bar { display: block; width: 28px;height: 6px;border-radius: 3px;margin-bottom: 18px;background: linear-gradient(90deg, var(--g-green), var(--g-blue));}
.trust .mono {font-size: 10px;margin-bottom: 14px;}
.trust-text {font-size: 17px; letter-spacing: -0.01em;}